{
  "compilerOptions": {
    "target": "es6",
    "module": "amd",
    "lib": [
      "dom",
      "es6",
      "dom.iterable",
      "scripthost"
    ],
    "sourceMap": true,
    "outFile": "./dist/app.js",
    "removeComments": true,
    "noEmitOnError": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "esModuleInterop": true,
    "experimentalDecorators": true,

    "types": []
  },
  "exclude": [
    "node_modules"
  ]
}