{
  "compilerOptions": {
    "target": "es6",
    "module": "es2015",

    "rootDir": "./src",
    "outDir": "./dist",

    "lib": [
      "dom",
      "es6",
      "dom.iterable",
      "scripthost"
    ],

    "sourceMap": true,
    "removeComments": true,
    "noEmitOnError": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "esModuleInterop": true,
    "experimentalDecorators": true,

    "types": []
  },

  "exclude": [
    "node_modules"
  ]
}